# Synawood — HOSTED (Vercel) env template. NAMES ONLY, never real values.
#
# Source of truth for hosted is Vercel Project -> Settings -> Environment Variables
# (injected into process.env at build/runtime). This repo never ships secrets:
# .env / .env.local / .env.production.local are all gitignored.
#
# Use this file to know WHICH keys to set in Vercel. To smoke-test hosted config
# locally, copy to `.env.production.local` (root) and `dashboard/.env.production.local`,
# fill real values, then `npm run build -w dashboard && npm run start -w dashboard`.
# Next.js loads `.env.production.local` (NODE_ENV=production) ahead of `.env.local`.

# --- Supabase (HOSTED Synawood project — NOT the private example, NOT local) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=<project-ref>
EXPECTED_SUPABASE_PROJECT_REF=<project-ref>

# --- Azure Blob (shared account; hosted writes to REAL paths, not local/) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=marketing-os
# MUST be false for hosted so blobs are NOT written under the local/ test prefix.
AZURE_BLOB_LOCAL_PREFIX=false

# --- Creative Studio ---
MODEL_PROFILE=founder-edit
STUDIO_RENDER_API=true
STUDIO_CHAT_API=true
# Marketplace stock adapters (ADR-0027). Keep false until Wave 2G.
MARKETPLACE_ADAPTERS=false
# Real generator keys (TTS + STT via AI Gateway openai/tts-1 + openai/whisper-1):
# AI_GATEWAY_API_KEY=
# OPENAI_API_KEY=  # optional reasoner fallback only
# STUDIO_REASONER_MODEL=openai/gpt-4.1-mini
# Waitlist confirmation mail (#340). Unset = skip send; the waitlist row still saves.
# RESEND_API_KEY=
# WAITLIST_MAIL_FROM=Synawood <hello@example.com>
# PERFORMANCE_TOKEN_KEY=
# Optional dedicated key for inbound MCP credentials (#957). 32-byte hex. Falls back to PERFORMANCE_TOKEN_KEY.
# MCP_SERVER_KEY=
# Optional OAuth app ids for Settings → Outcomes Connect (#246). Unset = paste-a-token only.
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# META_CLIENT_ID=
# META_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# STRIPE_CLIENT_ID=
# STRIPE_CLIENT_SECRET=
# DASHBOARD_PUBLIC_URL=https://your-dashboard.vercel.app
# Cron for /api/cron/performance-pull (#245). Unset = cron route 401s.
# CRON_SECRET=
# INSIGHTS_DIGEST_TO=

# --- Hosted billing (ADR-0082) ---
# BILLING_MODE=off|on
# off = skip wallet (local); on = hosted wallet gates.
# Production hosted must be on. Never BILLING_MODE=off on Vercel. Do not commit Stripe live keys.
# BILLING_MODE=on
# Stripe Checkout / Customer Portal / webhooks (#1000). Names only — set real values in Vercel.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STUDIO_MONTHLY=
# STRIPE_PRICE_TEAM_MONTHLY=
# Local webhook verify (not used on Vercel): stripe listen --forward-to localhost:3000/api/stripe/webhook

# --- Postiz (Plan 29 / ADR-0064). Hosted instance URL + key in Vercel. ---
# Always live on Vercel Production and Preview. Never mock. Fail-closes if URL/key missing (#795).
# POSTIZ_ADAPTER=live
# POSTIZ_BASE_URL=https://api.postiz.com/public/v1
# POSTIZ_API_KEY=
# POSTIZ_WEBHOOK_SECRET=
