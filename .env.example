# Synawood — local / deploy env names only. Copy to dashboard/.env.local or repo-root .env.local.
# Never commit real values. Dedicated Synawood Supabase project.

# --- Supabase ---
# Local-first: run `npx supabase start` and paste the printed values here.
# Local defaults (ports shifted to 5434x so it coexists with other stacks):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
#   SUPABASE_PROJECT_REF=marketing-os
# For a hosted Synawood project, use that project’s URL/keys, not another app’s database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
# Must match SUPABASE_PROJECT_REF when set (local default: marketing-os).
EXPECTED_SUPABASE_PROJECT_REF=
# Optional aliases used by @synawood/creative server helpers:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# --- Auth (Plan 07) ---
# Comma-separated emails allowed to complete signup/login in v1 (ADR-0024).
# Empty in production = deny everyone. Empty in local/dev = allow anyone.
# Put this in dashboard/.env.local (Next.js). supabase/.env.local is NOT read by the dashboard.
# AUTH_ALLOWLIST_EMAILS=founder@marketing-os.local
# Who may sign in: saas | invite_or_allowlist | allowlist. Unset = invite_or_allowlist.
# Production stays invite_or_allowlist until we flip it on purpose. Never commit secrets.
# AUTH_ACCESS_MODE=invite_or_allowlist
# Local QA only — force a Guide id (ignored in production).
# GUIDE_FORCE_ID=welcome-v1
# Optional local convenience after Auth user exists — attach yourself as owner of a Product you created (see migration 0013 comments).
#
# Google OAuth (optional for local smoke). Put secrets in supabase/.env for `npx supabase start`:
#   GOOGLE_CLIENT_ID=
#   GOOGLE_CLIENT_SECRET=
# Google Cloud authorized redirect (local Auth API): http://127.0.0.1:54341/auth/v1/callback
# App callback after exchange: http://127.0.0.1:3000/auth/callback
# Hosted: enable Google in Supabase Dashboard; redirect https://<ref>.supabase.co/auth/v1/callback
# Full steps: docs/architecture/product-auth.md
# Fallback without Google: email/password on /login still works.

# --- Azure Blob ---
# Quote the full string if you export it in a shell — bare `;` truncates the value and
# process.env then overrides dashboard/.env.local (Next.js precedence).
AZURE_STORAGE_CONNECTION_STRING=
# Optional fallbacks when the connection string is incomplete (#479):
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=marketing-os
# Keep true for local/dev keys (writes under local/marketing-os/{product}/...)
AZURE_BLOB_LOCAL_PREFIX=true

# --- Creative Studio ---
# Default: founder-edit (Gateway reasoner + openai/tts-1). Requires AI_GATEWAY_API_KEY.
MODEL_PROFILE=founder-edit
# Set false to disable /api/studio/render enqueue (rollback / kill-switch).
STUDIO_RENDER_API=true
# Set false to disable Studio Agent chat (Plan 02 rollback).
STUDIO_CHAT_API=true
# Marketplace stock adapters (ADR-0027). Off by default — stubs never purchase.
# Set true only to expose Wave 2G placeholder adapters in local experiments.
MARKETPLACE_ADAPTERS=false
# Asset index face-detect stage (ADR-0032 / #176). Off by default — privacy.
# When true, index marks face_detect_ran after a stub pass (no celebrity labeling).
# ASSET_FACE_DETECT=true
# Agent Marketplace (ADR-0039): allow unsigned pack installs in local founder testing only.
# ALLOW_UNSIGNED_PACKS=true
# Optional Ed25519 public key PEM for verifying pack signatures:
# PACK_SIGNING_PUBLIC_KEY_PEM=
# Local Next only: auto-spawn render/extract workers after enqueue (default on in development).
# STUDIO_RENDER_INLINE=false
# STUDIO_EXTRACT_INLINE=false
# Optional generator budget caps (GBP). Defaults: monthly 100 / weekly soft 25 / per-project warn 5.
# STUDIO_MONTHLY_GENERATOR_CAP_GBP=100
# STUDIO_WEEKLY_SOFT_CAP_GBP=25
# STUDIO_PER_PROJECT_WARN_GBP=5
# Vercel AI Gateway — Studio chat reasoner, Gateway images, TTS (openai/tts-1), STT (openai/whisper-1):
# AI_GATEWAY_API_KEY=
# Optional direct OpenAI fallback for reasoner only (TTS does not use this):
# OPENAI_API_KEY=
# STUDIO_REASONER_MODEL=openai/gpt-4.1-mini
# ElevenLabs Music (ADR-0041) and Instant Voice Clone (ADR-0060). Same key for both.
# Required for generate_music and live clone outside CI (`MODEL_PROFILE=ci-stub` stubs clone):
# ELEVENLABS_API_KEY=
# Waitlist confirmation mail (#340). Unset = skip send; the waitlist row still saves.
# RESEND_API_KEY=
# WAITLIST_MAIL_FROM=Synawood <hello@localhost>
# Performance ingestion (#239). 32-byte hex (64 chars). Unset = token paste fails closed.
# PERFORMANCE_TOKEN_KEY=
# Optional dedicated key for inbound MCP credentials (#957). 32-byte hex. Falls back to PERFORMANCE_TOKEN_KEY.
# MCP_SERVER_KEY=
# Optional OAuth app ids for Settings → Outcomes Connect (#246). Unset = paste-a-token only.
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# META_CLIENT_ID=
# META_CLIENT_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# STRIPE_CLIENT_ID=
# STRIPE_CLIENT_SECRET=
# DASHBOARD_PUBLIC_URL=http://127.0.0.1:3011
# Cron for /api/cron/performance-pull (#245). Unset = cron route 401s.
# CRON_SECRET=
# Optional weekly Insights digest (#259). Unset = preview only; no send.
# INSIGHTS_DIGEST_TO=

# --- Postiz (Plan 29 / ADR-0064). Names only — never commit values. ---
# CI / Vitest only: POSTIZ_ADAPTER=mock (never hits a host).
# Local founder review and Vercel: POSTIZ_ADAPTER=live + real URL/key.
# Missing live config = empty/error state, not demo accounts.
# POSTIZ_ADAPTER=live
# Public API root: Cloud https://api.postiz.com/public/v1 or self-host https://{domain}/api/public/v1
# POSTIZ_BASE_URL=
# POSTIZ_API_KEY=
# Optional; webhook ingest (#806). Unset = poll-only posted-status.
# POSTIZ_WEBHOOK_SECRET=

# --- Hosted billing (ADR-0082) ---
# BILLING_MODE=off|on
# off = skip wallet (local); on = hosted wallet gates.
# Local founder default is off. Production hosted must be on. Do not commit Stripe live keys.
# BILLING_MODE=off
# Stripe Checkout / Customer Portal / webhooks (#1000). Names only — never commit values.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STUDIO_MONTHLY=
# STRIPE_PRICE_TEAM_MONTHLY=
# Local webhook verify: stripe listen --forward-to localhost:3000/api/stripe/webhook

# --- Plan flags (#270 / ADR-0037) ---
# founding (default) includes every job function. preview = editor+analyst so upsell chips
# can be reviewed locally. There is no billing checkout yet.
# SYNAWOOD_PRODUCT_PLAN=founding

# --- Smoke / post-merge (GitHub Actions secrets — never commit values) ---
# SUPABASE_DB_URL=[redacted-db-url]
# PROD_BASE_URL=https://your-dashboard.vercel.app
# Local smoke: SMOKE_BASE_URL=http://localhost:3000
# SMOKE_BASE_URL=http://localhost:3000

