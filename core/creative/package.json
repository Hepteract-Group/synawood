  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:daily": "vitest run --config vitest.coverage-daily.config.ts --coverage",
    "test:ad-generator": "vitest run src/brief src/variant src/extract src/marketplace src/generation-jobs/estimate-extract.test.ts src/generation-jobs/fill-brief-from-digest.test.ts src/generation-jobs/enrich-brief-from-vision.test.ts src/generation-jobs/run-extract.test.ts",
