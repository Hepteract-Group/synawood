    "test:eval": "vitest run src/agent/eval",
    "smoke:blob": "node --env-file-if-exists=../../.env --import tsx src/persistence/smoke-blob.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.23",
