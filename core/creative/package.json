    "./project/client": "./src/project/client.ts",
    "./project/*": "./src/project/*.ts",
    "./authored": "./src/authored/index.ts",
    "./authored/client": "./src/authored/client.ts",
    "./authored/path-c-wrap": "./src/authored/path-c-wrap.tsx",
