    "@supabase/supabase-js": "^2.50.0",
    "ai": "^7.0.31",
    "lottie-web": "^5.13.0",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.52.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remotion": "^4.0.490",
    "server-only": "^0.0.1",
    "three": "^0.160.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
