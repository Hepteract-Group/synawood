{
  "name": "dashboard",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:authored-player": "node --import tsx scripts/build-authored-player.mjs",
    "dev": "npm run build:authored-player && next dev --turbopack",
    "dev:webpack": "npm run build:authored-player && next dev",
    "dev:health": "node --import tsx scripts/dev-health.ts",
    "build": "npm run build:authored-player && next build",
