    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.16",
    "@remotion/lottie": "^4.0.490",
    "@remotion/player": "^4.0.490",
