    "@remotion/three": "^4.0.490",
    "@remotion/transitions": "^4.0.490",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "@synawood/channels": "*",
    "@synawood/creative": "*",
    "ai": "^7.0.31",
    "lottie-web": "^5.13.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "^4.0.490",
    "three": "^0.160.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "esbuild": "^0.25.12",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
