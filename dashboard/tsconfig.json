{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "noEmit": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@synawood/creative": ["../core/creative/src/index.ts"],
      "@synawood/creative/*": ["../core/creative/src/*"],
      "@synawood/channels": ["../core/channels/src/index.ts"],
      "@synawood/channels/*": ["../core/channels/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
