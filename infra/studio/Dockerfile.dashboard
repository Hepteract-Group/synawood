FROM node:22-bookworm

WORKDIR /app
ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1

COPY package.json package-lock.json ./
COPY dashboard/package.json dashboard/package.json
COPY core/creative/package.json core/creative/package.json
COPY core/channels/package.json core/channels/package.json
COPY packages/mos-sdk-ts/package.json packages/mos-sdk-ts/package.json

RUN npm ci

COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev", "-w", "dashboard", "--", "--hostname", "0.0.0.0", "--port", "3000"]
