# Copy to infra/postiz/.env.fly (gitignored). Used by infra/postiz/fly/deploy.sh only.
# Source: dashboard/.env.local Cloudflare block + generated JWT. Never commit values.

# Fly app names (defaults match deploy.sh)
FLY_POSTIZ_APP=mos-postiz
FLY_POSTIZ_PG=mos-postiz-pg
FLY_POSTIZ_REDIS=mos-postiz-redis
FLY_TEMPORAL_MPG=mos-postiz-temporal-pg-mpg
FLY_REGION=lhr

# Public URL (fly.dev until postiz.synawood.com DNS is live)
POSTIZ_PUBLIC_URL=https://mos-postiz.fly.dev

# Postiz core
JWT_SECRET=

# R2 (Postiz names — map from dashboard/.env.local)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKETNAME=postiz-media-dev
CLOUDFLARE_BUCKET_URL=https://<account_id>.r2.cloudflarestorage.com
CLOUDFLARE_REGION=auto

# Social provider OAuth (names only). Without these, Add Channel → X shows
# "Could not connect to the platform". Values go on Fly secrets, never git.
# Callbacks on the X/LinkedIn/TikTok developer apps must match POSTIZ_PUBLIC_URL:
#   https://mos-postiz.fly.dev/integrations/social/x
#   https://mos-postiz.fly.dev/integrations/social/linkedin
#   https://mos-postiz.fly.dev/integrations/social/linkedin-page
#   https://mos-postiz.fly.dev/integrations/social/tiktok
X_API_KEY=
X_API_SECRET=
# Some Postiz builds also need OAuth2 client id/secret:
# X_CLIENT=
# X_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# Set by deploy.sh after attach (do not hand-edit unless rotating)
# DATABASE_URL=
# REDIS_URL=
# TEMPORAL_ADDRESS=
